diff --git a/kernel/kalloc.c b/kernel/kalloc.c
index 0699e7e..61b7293 100644
--- a/kernel/kalloc.c
+++ b/kernel/kalloc.c
@@ -23,10 +23,65 @@ struct {
   struct run *freelist;
 } kmem;
 
+// task 4.1
+// ---- Reference counts: one per physical page in [KERNBASE, PHYSTOP) ----
+#define NPAGES     ((PHYSTOP - KERNBASE) / PGSIZE)
+#define PA2IDX(pa) (((uint64)(pa) - KERNBASE) >> PGSHIFT)
+
+struct {
+  struct spinlock lock;
+  // One counter per physical page: index = (pa - KERNBASE) >> 12
+  int refcnt[NPAGES];  // <-- was (PHYSTOP)/PGSIZE
+} pref;
+
+static inline int
+valid_idx(int i){ return i >= 0 && i < NPAGES; }
+// task 4.1
+
+// task 4.1
+// Increment refcount of a PA known to correspond to a full page.
+void
+incref(uint64 pa)
+{
+  int i = PA2IDX(pa);
+  if(!valid_idx(i)) panic("incref: bad pa");
+  acquire(&pref.lock);
+  pref.refcnt[i] += 1;
+  release(&pref.lock);
+}
+
+// Decrement refcount, return new count. If it hits 0, caller may free.
+int
+decref(uint64 pa)
+{
+  int i = PA2IDX(pa);
+  if(!valid_idx(i)) panic("decref: bad pa");
+  acquire(&pref.lock);
+  if(pref.refcnt[i] > 0)
+    pref.refcnt[i] -= 1;
+  int v = pref.refcnt[i];
+  release(&pref.lock);
+  return v;
+}
+
+int
+getref(uint64 pa)
+{
+  int i = PA2IDX(pa);
+  if(!valid_idx(i)) panic("getref: bad pa");
+  acquire(&pref.lock);
+  int v = pref.refcnt[i];
+  release(&pref.lock);
+  return v;
+}
+// task 4.1
+
+
 void
 kinit()
 {
   initlock(&kmem.lock, "kmem");
+    initlock(&pref.lock, "pref");  // <-- needed before freerange -> kfree -> decref // task 4.1
   freerange(end, (void*)PHYSTOP);
 }
 
@@ -51,6 +106,12 @@ kfree(void *pa)
   if(((uint64)pa % PGSIZE) != 0 || (char*)pa < end || (uint64)pa >= PHYSTOP)
     panic("kfree");
 
+  // If this is an init-time free (ref=0), we'll...
+  if(decref((uint64)pa) > 0){
+    return;
+  }
+  // task 4.1  
+
   // Fill with junk to catch dangling refs.
   memset(pa, 1, PGSIZE);
 
@@ -78,5 +139,16 @@ kalloc(void)
 
   if(r)
     memset((char*)r, 5, PGSIZE); // fill with junk
+
+    if(r){
+  memset((char*)r, 5, PGSIZE); // fill with junk
+  // task 4.1
+  int i = PA2IDX((uint64)r);
+  if(!valid_idx(i)) panic("kalloc: bad pa");
+  acquire(&pref.lock);
+  pref.refcnt[i] = 1;
+  release(&pref.lock); // task 4.1
+  }
+    
   return (void*)r;
 }
