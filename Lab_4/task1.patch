+// task 4.1
+// Allocate a private (writable) copy for VA page va0 in pagetable
+// when it currently maps a COW page.
+// Returns 0 on success, -1 on failure.
+int
+cow_alloc(pagetable_t pagetable, uint64 va0)
+{
+  pte_t *pte = walk(pagetable, va0, 0);
+  if(pte == 0) return -1;
+  if((*pte & PTE_V) == 0) return -1;
+
+  // Only act if it is a user COW mapping.
+  if(((*pte & PTE_U) == 0) || ((*pte & PTE_COW) == 0))
+    return -1;
+
+  uint64 oldpa = PTE2PA(*pte);
+  uint flags = PTE_FLAGS(*pte);
+
+  // If nobody else shares it, just flip W and clear COW.
+  if(getref(oldpa) == 1){
+    *pte = PA2PTE(oldpa) | ((flags | PTE_W) & ~PTE_COW);
+    sfence_vma();
+    return 0;
+  }
+
+  // Shared with others: allocate and copy.
+  char *mem = kalloc();
+  if(mem == 0)
+    return -1;
+  memmove(mem, (char*)oldpa, PGSIZE);
+
+  // Point PTE at the new page, writable, not COW.
+  *pte = PA2PTE((uint64)mem) | ((flags | PTE_W) & ~PTE_COW);
+
+  // Drop our reference to the old shared page.
+  kfree((void*)oldpa);
+
+  sfence_vma();
+  return 0;
+}
