diff --git a/user/cowtest.c b/user/cowtest.c
new file mode 100644
index 0000000..1330920
--- /dev/null
+++ b/user/cowtest.c
@@ -0,0 +1,68 @@
+// user/cowtest.c
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static void print_state(const char *tag, void *p) {
+  uint64 pa = v2p(p);
+  int rc = pgref(p);
+  printf("%s: va=%p pa=%p ref=%d\n", tag, p, (void*)pa, rc);
+}
+
+int
+main(void)
+{
+  // Allocate one page and align pointer to page start.
+  char *p = sbrk(4096);
+  if(p == (char*)-1){
+    printf("cowtest: sbrk failed\n");
+    exit(1);
+  }
+  p = (char*)(((uint64)p + 4095) & ~((uint64)4095));
+
+  // Touch it so the page exists and is writable pre-fork.
+  *p = 0x2A; // 42
+
+  int pid = fork();
+  if(pid < 0){
+    printf("cowtest: fork failed\n");
+    exit(1);
+  }
+
+  if(pid == 0){
+    // Child
+    print_state("child: before write", p);
+
+    // First write triggers COW in child.
+    *p = 0x7B; // 123
+
+    print_state("child: after write", p);
+    // Sanity: child's value must be 123 now.
+    if(*p != 0x7B){
+      printf("cowtest: child write failed (%d)\n", *p);
+      exit(1);
+    }
+    exit(0);
+  } else {
+    // Parent
+    // Small delay so child likely prints its "before write" first.
+    sleep(5);
+    print_state("parent: post-fork", p);
+
+    // Wait for child to do COW work.
+    wait(0);
+
+    // After child COWs, parent should still point to original PA,
+    // and refcount should now be 1 (child moved to a new page).
+    print_state("parent: after wait", p);
+
+    // Parent sees original value.
+    if(*p != 0x2A){
+      printf("cowtest: parent saw corrupted value (%d)\n", *p);
+      exit(1);
+    }
+
+    printf("cowtest: OK\n");
+    exit(0);
+  }
+}
