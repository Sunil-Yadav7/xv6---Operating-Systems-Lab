diff --git a/kernel/paging.h b/kernel/paging.h
new file mode 100644
index 0000000..ea2512c
--- /dev/null
+++ b/kernel/paging.h
@@ -0,0 +1,52 @@
+// kernel/paging.h
+#ifndef _PAGING_H_
+#define _PAGING_H_
+
+#include "types.h"
+#include "param.h"
+#include "riscv.h"
+
+// Forward-declare proc so we can use pointers to it in prototypes/structs.
+struct proc;
+
+// ---- Swap bookkeeping ----
+#ifndef MAXSWAP
+#define MAXSWAP 1024
+#endif
+
+struct swapent {
+    uint64 va;  // page-aligned VA
+    int    used; // 0/1
+};
+
+// ---- Per-proc paging stats ----
+struct pagestat {
+    uint64 faults;
+    uint64 swapins;
+    uint64 swapouts;
+};
+
+// ---- MRU node ----
+struct mru_node {
+    struct mru_node *prev;
+    struct mru_node *next;
+    struct proc     *p;
+    uint64          va;  // page-aligned VA
+};
+
+// ---- MRU / swap APIs ----
+void mru_init(void);
+void mru_on_map(struct proc *p, uint64 va);
+void mru_on_unmap(struct proc *p, uint64 va);
+void mru_touch(struct proc *p, uint64 va);
+int  mru_evict_one(struct proc **victim_p, uint64 *victim_va);
+void mru_purge_proc(struct proc *p);
+void mru_dump(void);
+
+int  swap_lookup(struct proc *p, uint64 va, int *slot_out); // -1 if not swapped
+int  swap_out_page(struct proc *p, uint64 va);             // write page to swap
+int  swap_in_page(struct proc *p, uint64 va);              // read page from swap
+void swap_destroy(struct proc *p);
+void swap_forget_va(struct proc *p, uint64 va);            // clear mapping for VA
+
+#endif // _PAGING_H_
