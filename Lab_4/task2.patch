diff --git a/kernel/mru.c b/kernel/mru.c
new file mode 100644
index 0000000..79092fb
--- /dev/null
+++ b/kernel/mru.c
@@ -0,0 +1,206 @@
+// kernel/mru.c
+#include "types.h"
+#include "spinlock.h"
+#include "param.h"
+#include "proc.h"
+#include "riscv.h"
+#include "defs.h"
+#include "paging.h"
+
+#define MRU_DUMP_MAX 32
+
+static struct {
+    struct spinlock lock;
+    struct mru_node *head; // Most-recent page at head. MRU policy: evict head first.
+} mru;
+
+void
+mru_init(void)
+{
+    initlock(&mru.lock, "mru");
+    mru.head = 0;
+}
+
+// -------- internal helpers (require mru.lock) --------
+
+static inline void
+unlink(struct mru_node *n)
+{
+    if (n->prev) n->prev->next = n->next; else mru.head = n->next;
+    if (n->next) n->next->prev = n->prev;
+    n->prev = n->next = 0;
+}
+
+static inline void
+link_front(struct mru_node *n)
+{
+    n->prev = 0;
+    n->next = mru.head;
+    if (mru.head) mru.head->prev = n;
+    mru.head = n;
+}
+
+// find expects page-aligned VA; lock must be held
+static inline struct mru_node*
+find_aligned_locked(struct proc *p, uint64 va_aligned)
+{
+    for (struct mru_node *n = mru.head; n; n = n->next)
+        if (n->p == p && n->va == va_aligned)
+            return n;
+    return 0;
+}
+
+void
+mru_on_map(struct proc *p, uint64 va)
+{
+    va = PGROUNDDOWN(va);
+    
+    // Optimistically allocate outside the lock (best-effort)
+    struct mru_node *m = (struct mru_node*)kalloc();
+    if (m) { m->p = p; m->va = va; m->prev = m->next = 0; }
+
+    acquire(&mru.lock);
+    
+    // Re-check under the lock to avoid duplicates from races
+    struct mru_node *existing = find_aligned_locked(p, va);
+    if (existing) {
+        if (existing != mru.head) { unlink(existing); link_front(existing); }
+        release(&mru.lock);
+        if (m) kfree((void*)m); // didn't need the fresh node
+        return;
+    }
+
+    // No existing node: insert if we managed to allocate one
+    if (m) {
+        link_front(m);
+        m = 0; // consumed
+    }
+    release(&mru.lock);
+
+    if (m) kfree((void*)m);
+}
+
+void
+mru_touch(struct proc *p, uint64 va)
+{
+    va = PGROUNDDOWN(va);
+    acquire(&mru.lock);
+    struct mru_node *n = find_aligned_locked(p, va);
+    if (n && n != mru.head) { unlink(n); link_front(n); }
+    release(&mru.lock);
+}
+
+void
+mru_on_unmap(struct proc *p, uint64 va)
+{
+    va = PGROUNDDOWN(va);
+    acquire(&mru.lock);
+    for (struct mru_node *n = mru.head, *next; n; n = next) {
+        next = n->next;
+        if (n->p == p && n->va == va) {
+            unlink(n);
+            kfree((void*)n);
+        }
+    }
+    release(&mru.lock);
+}
+
+void
+mru_purge_proc(struct proc *p)
+{
+    acquire(&mru.lock);
+    for (struct mru_node *n = mru.head, *next; n; n = next) {
+        next = n->next;
+        if (n->p == p) {
+            unlink(n);
+            kfree((void*)n);
+        }
+    }
+    release(&mru.lock);
+}
+
+int
+mru_evict_one(struct proc **victim_p, uint64 *victim_va)
+{
+    acquire(&mru.lock);
+    for (struct mru_node *n = mru.head; n; n = n->next) {
+        // Defensive: drop bogus entries if any appear
+        if (n->va >= MAXVA) {
+            struct mru_node *bad = n;
+            n = n->next;
+            unlink(bad);
+            kfree((void*)bad);
+            if (!n) break;
+        }
+
+        // Inspect PTE & PA under lock
+        pte_t *pte = walk(n->p->pagetable, n->va, 0);
+        if (!pte || !(*pte & PTE_V) || !(*pte & PTE_U))
+            continue;
+
+        // Leaf only: requires at least one of R/W/X
+        if ((*pte & (PTE_R | PTE_W | PTE_X)) == 0)
+            continue;
+
+        uint64 pa = PTE2PA(*pte);
+
+        // Do not evict shared/COW pages
+        if (getref(pa) > 1)
+            continue;
+
+        // Safety guards
+        if (!(*pte & PTE_U)) panic("evict non-user");
+        if ((*pte & (PTE_R|PTE_W|PTE_X)) == 0) panic("evict non-leaf");
+
+#ifdef MRU_DEBUG
+        uint64 headva = mru.head ? mru.head->va : 0;
+        printf("[evict] pid=%d va=%p head=%p %s\n",
+               n->p->pid, (void*)n->va, (void*)headva,
+               (headva == n->va) ? "OK:MRU" : "MISMATCH");
+#endif
+
+        // Found MRU victim; pop from list now.
+        *victim_p = n->p;
+        *victim_va = n->va;
+
+        unlink(n);
+        kfree((void*)n);
+
+        release(&mru.lock);
+        return 1;
+    }
+    release(&mru.lock);
+    return 0;
+}
+
+void
+mru_dump(void)
+{
+    acquire(&mru.lock);
+    int shown = 0, total = 0;
+    printf("MRU(head->tail): ");
+    for (struct mru_node *n = mru.head; n; n = n->next) {
+        if (shown < MRU_DUMP_MAX) {
+            printf("(%d,%p) ", n->p->pid, (void*)n->va);
+            shown++;
+        }
+        total++;
+    }
+    if (total > MRU_DUMP_MAX)
+        printf("... (+%d more)", total - MRU_DUMP_MAX);
+    printf("\n");
+    release(&mru.lock);
+}
+
+void
+mru_remove(struct proc *p, uint64 va)
+{
+    va = PGROUNDDOWN(va);
+    acquire(&mru.lock);
+    struct mru_node *n = find_aligned_locked(p, va);
+    if (n) {
+        unlink(n);
+        kfree((void*)n);
+    }
+    release(&mru.lock);
+}
