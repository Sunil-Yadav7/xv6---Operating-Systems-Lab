diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 419e727..d16584b 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -107,3 +107,38 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+// helper function to locate a process by PID
+struct proc*
+findproc(int pid)
+{
+    for(struct proc *p = proc; p < &proc[NPROC]; p++){
+        if(p->pid == pid) return p;
+    }
+    return 0;
+}
+
+// sys_getpagestat: arg0 = pid (0 for current), arg1 = user pointer to struct pagestat
+uint64
+sys_getpagestat(void)
+{
+    int pid; uint64 uaddr;
+    argint(0, &pid);
+    argaddr(1, &uaddr);
+    
+    struct proc *q = findproc(pid);
+    if(!q) return -1;
+    
+    struct pagestat st = q->pgstat; // Ensure the name matches your struct in proc.h
+    if(copyout(myproc()->pagetable, uaddr, (char*)&st, sizeof(st)) < 0)
+        return -1;
+    return 0;
+}
+
+// sys_dumpmru: invokes the kernel-side mru_dump to print list to console
+uint64
+sys_dumpmru(void)
+{
+    mru_dump();
+    return 0;
+}
