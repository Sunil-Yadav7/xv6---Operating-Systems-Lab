new file mode 100644
index 0000000..6d497c7
--- /dev/null
+++ b/user/mrumem.c
@@ -0,0 +1,114 @@
+// user/mrumem.c - direct-touch version (no pipe)
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static inline int pagesize(void){ return 4096; }
+
+static void show_delta(const char *label,
+                       struct pagestat *prev, struct pagestat *now)
+{
+    int df = (int)(now->faults - prev->faults);
+    int di = (int)(now->swapins - prev->swapins);
+    int do_ = (int)(now->swapouts - prev->swapouts);
+    if (label && *label) printf("%s ", label);
+    printf("+faults=%d +swapins=%d +swapouts=%d\n", df, di, do_);
+    *prev = *now;
+}
+
+int
+main(void)
+{
+    int me = getpid();
+    struct pagestat base = {0,0,0}, cur;
+
+    if (getpagestat(me, &base) < 0) {
+        printf("mrumem: getpagestat failed\n");
+        exit(1);
+    }
+
+    int ps = pagesize();
+    char *baseptr = 0;
+    int total = 0;
+
+    // ---- Phase 1: grow in small steps, fill known pattern, stop once swapouts>0
+    const int step = 64;        // 64 pages = 256 KiB per step; good for -m 8
+    int saw_swapout = 0;
+
+    for (;;) {
+        char *old = sbrk(step * ps);
+        if (old == (char*)-1) { 
+            printf("sbrk failed at total=%d\n", total); 
+            break; 
+        }
+        if (!baseptr) baseptr = old;
+
+        for (int i = 0; i < step; i++) {
+            int j = total + i;
+            volatile char *p = baseptr + (uint64)j * ps;
+            *p = (char)(j & 0xFF);          // write known byte per page
+        }
+        total += step;
+
+        if (getpagestat(me, &cur) == 0) {
+            printf("[grow npages=%d] ", total);
+            show_delta("", &base, &cur);
+            if ((int)cur.swapouts > 0) { 
+                saw_swapout = 1; 
+                break; 
+            }
+        } else {
+            break;
+        }
+    }
+
+    if (!saw_swapout) {
+        printf("note: no swapouts yet - try running with smaller RAM (e.g., -m 8) or keep growing.\n");
+    }
+
+    // ---- Phase 2: force swap-ins by directly touching the *newest* pages
+    // MRU evicts the most-recently-touched (the tail of our growth).
+    // Re-reading those newest pages should fault and swap them back in.
+    int W = 64;
+    if (W > total) W = total;
+    int window_start = total - W;
+
+    struct pagestat thr0;
+    if (getpagestat(me, &thr0) == 0) {
+        int iters = W * 16;             // a few cycles across the window
+        for (int t = 0; t < iters; t++) {
+            int idx = window_start + (t % W);
+            volatile char *p = baseptr + (uint64)idx * ps;
+            char v = *p; (void)v;       // user-mode read -> page fault -> swap-in
+        }
+        if (getpagestat(me, &cur) == 0) {
+            printf("[swap-in window] ");
+            show_delta("", &thr0, &cur); // expect +swapins > 0 here
+        }
+    }
+
+    // ---- Phase 3: verify data survived swap
+    int bad = 0;
+    int stride = 97;
+    if (stride > total) stride = 1;
+    for (int j = 0; j < total; j += stride) {
+        volatile char *p = baseptr + (uint64)j * ps;
+        char got = *p, want = (char)(j & 0xFF);
+        if (got != want) {
+            printf("VERIFY: mismatch at page %d (got %d, want %d)\n",
+                   j, (int)got, (int)want);
+            bad = 1; 
+            break;
+        }
+    }
+    printf("VERIFY: %s\n", bad ? "FAIL" : "OK");
+
+    // Totals + optional snapshot
+    if (getpagestat(me, &cur) == 0) {
+        printf("TOTAL: faults=%d swapins=%d swapouts=%d\n",
+               (int)cur.faults, (int)cur.swapins, (int)cur.swapouts);
+    }
+    dumpmru();
+    printf("mrumem: done\n");
+    exit(0);
+}
