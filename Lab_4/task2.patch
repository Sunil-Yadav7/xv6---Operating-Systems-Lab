+    return 0;
+}
+
+// kalloc wrapper that triggers eviction if memory is full
+char *
+alloc_page_maybe_evict(void)
+{
+    for (;;) {
+        char *m = kalloc();
+        if (m) return m;
+        
+        // If kalloc fails, try to evict one page and retry
+        if (try_evict_one() < 0)
+            return 0; // Out of memory: nothing left to evict
+    }
+}
+
+int
+handle_pf(struct proc *p, uint64 va, int is_write)
+{
+  p->pgstat.faults++;             // count every user page fault
+  va = PGROUNDDOWN(va);
+
+  // 1) swapped?
+  int slot;
+  if (swap_lookup(p, va, &slot) >= 0) {
+    if (swap_in_page(p, va) < 0) return -1;
+    mru_touch(p, va);
+    return 0;
+  }
+
+  // 2) else, fresh anonymous page
+  char *mem = alloc_page_maybe_evict();
+  if (!mem) return -1;
+  memset(mem, 0, PGSIZE);
+  if (mappages(p->pagetable, va, PGSIZE, (uint64)mem, PTE_U|PTE_R|PTE_W) < 0) {
+    kfree(mem);
+    return -1;
+  }
+  mru_on_map(p, va);
+  mru_touch(p, va);
+  return 0;
+}
