diff --git a/kernel/swap.c b/kernel/swap.c
new file mode 100644
index 0000000..82b5781
--- /dev/null
+++ b/kernel/swap.c
@@ -0,0 +1,190 @@
+// kernel/swap.c
+#include "types.h"
+#include "riscv.h"
+#include "defs.h"
+#include "param.h"
+#include "fs.h"
+#include "spinlock.h"
+#include "sleeplock.h"
+#include "file.h"
+#include "proc.h"
+#include "paging.h"
+
+void
+swap_forget_va(struct proc *p, uint64 va)
+{
+    for (int i = 0; i < MAXSWAP; i++) {
+        if (p->swapmap[i].used && p->swapmap[i].va == va) {
+            p->swapmap[i].used = 0;
+            p->swapmap[i].va   = 0;
+            return;
+        }
+    }
+}
+
+static void itoa_dec(int x, char *buf) {
+    char tmp[16];
+    int i = 0;
+    if (x == 0) { buf[0] = '0'; buf[1] = 0; return; }
+    while (x > 0 && i < (int)sizeof(tmp)) {
+        tmp[i++] = '0' + (x % 10);
+        x /= 10;
+    }
+    int j = 0;
+    while (i > 0) buf[j++] = tmp[--i];
+    buf[j] = 0;
+}
+
+static void build_swap_name(char *dst, int pid) {
+    char num[16];
+    itoa_dec(pid, num);
+    char *p = dst;
+    *p++ = '/';
+    *p++ = 's'; *p++ = 'w'; *p++ = 'a'; *p++ = 'p'; *p++ = '.';
+    for (int i = 0; num[i]; i++) *p++ = num[i];
+    *p = 0;
+}
+
+static int
+swap_open(struct proc *p)
+{
+    if (p->swapip)
+        return 0;
+
+    char path[32];
+    build_swap_name(path, p->pid);
+
+    begin_op();
+    struct inode *ip = namei(path);
+    if (ip == 0) {
+        char name[DIRSIZ];
+        struct inode *dp = nameiparent(path, name);
+        if (dp == 0) {
+            end_op();
+            return -1;
+        }
+        ilock(dp);
+        ip = dirlookup(dp, name, 0);
+        if (ip) {
+            iunlockput(dp);
+            ilock(ip);
+            iunlock(ip);
+        } else {
+            ip = ialloc(dp->dev, T_FILE);
+            if (ip == 0) {
+                iunlockput(dp);
+                end_op();
+                return -1;
+            }
+            ilock(ip);
+            ip->major = 0;
+            ip->minor = 0;
+            ip->nlink = 1;
+            iupdate(ip);
+            if (dirlink(dp, name, ip->inum) < 0) {
+                iunlockput(ip);
+                iunlockput(dp);
+                end_op();
+                return -1;
+            }
+            iunlock(ip);
+            iunlockput(dp);
+        }
+    } else {
+        ilock(ip);
+        iunlock(ip);
+    }
+    end_op();
+    p->swapip = ip;
+    return 0;
+}
+
+int
+swap_lookup(struct proc *p, uint64 va, int *slot_out)
+{
+    va = PGROUNDDOWN(va);
+    for (int i = 0; i < MAXSWAP; i++) {
+        if (p->swapmap[i].used && p->swapmap[i].va == va) {
+            if (slot_out) *slot_out = i;
+            return i;
+        }
+    }
+    return -1;
+}
+
+int
+swap_out_page(struct proc *p, uint64 va)
+{
+    if (swap_open(p) < 0) return -1;
+
+    int slot = -1;
+    for (int i = 0; i < MAXSWAP; i++) if (!p->swapmap[i].used) { slot = i; break; }
+    if (slot < 0) return -1;
+
+    va = PGROUNDDOWN(va);
+    pte_t *pte = walk(p->pagetable, va, 0);
+    if (!pte || !(*pte & PTE_V) || !(*pte & PTE_U)) return -1;
+
+    uint64 pa = PTE2PA(*pte);
+
+    begin_op();
+    ilock(p->swapip);
+    int ok = (writei(p->swapip, 0, pa, (uint)slot * PGSIZE, PGSIZE) == PGSIZE);
+    iunlock(p->swapip);
+    end_op();
+    if (!ok) return -1;
+
+    p->swapmap[slot].used = 1;
+    p->swapmap[slot].va   = va;
+
+    uvmunmap(p->pagetable, va, 1, 0);
+    *pte = 0;
+
+    p->pgstat.swapouts++;
+    return 0;
+}
+
+int
+swap_in_page(struct proc *p, uint64 va)
+{
+    if (!p || !p->pagetable) return -1;
+    if (swap_open(p) < 0) return -1;
+
+    int slot;
+    if (swap_lookup(p, PGROUNDDOWN(va), &slot) < 0) return -1;
+
+    char *mem = alloc_page_maybe_evict();
+    if (!mem) return -1;
+
+    begin_op();
+    ilock(p->swapip);
+    int ok = (readi(p->swapip, 0, (uint64)mem, (uint)slot * PGSIZE, PGSIZE) == PGSIZE);
+    iunlock(p->swapip);
+    end_op();
+    if (!ok) { kfree(mem); return -1; }
+
+    if (mappages(p->pagetable, PGROUNDDOWN(va), PGSIZE, (uint64)mem, PTE_U|PTE_R|PTE_W) < 0) {
+        kfree(mem);
+        return -1;
+    }
+
+    p->swapmap[slot].used = 0;
+    p->swapmap[slot].va   = 0;
+
+    p->pgstat.swapins++;
+    mru_on_map(p, va);
+    return 0;
+}
+
+void
+swap_destroy(struct proc *p)
+{
+    if (p->swapip) {
+        iput(p->swapip);
+        p->swapip = 0;
+    }
+    for (int i = 0; i < MAXSWAP; i++) {
+        p->swapmap[i].used = 0;
+        p->swapmap[i].va   = 0;
+    }
+}
