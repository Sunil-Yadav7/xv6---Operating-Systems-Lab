diff --git a/user/symlinktest.c b/user/symlinktest.c
new file mode 100644
index 0000000..a5c1d9b
--- /dev/null
+++ b/user/symlinktest.c
@@ -0,0 +1,165 @@
+// user/symlinktest.c
+#include "kernel/param.h"
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fs.h"
+#include "kernel/fcntl.h"
+
+void
+test_stat(char *path, short type, int size)
+{
+  struct stat st;
+  if(stat(path, &st) < 0){
+    printf("stat %s failed\n", path);
+    exit(1);
+  }
+  if(st.type != type){
+    printf("stat %s: wrong type %d != %d\n", path, st.type, type);
+    exit(1);
+  }
+  if(size >= 0 && st.size != size){
+    printf("stat %s: wrong size %ld != %d\n", path, st.size, size);
+    exit(1);
+  }
+}
+
+int
+main(void)
+{
+  printf("Starting symlinktest\n");
+
+  // Test 1: Basic symlink to a file
+  printf("1. Basic file symlink...\n");
+  int fd = open("testfile", O_CREATE | O_WRONLY);
+  if(fd < 0) {
+    printf("failed to create testfile\n");
+    exit(1);
+  }
+  char buf[] = "hello";
+  write(fd, buf, sizeof(buf));
+  close(fd);
+
+  if(symlink("testfile", "testlink") < 0) {
+    printf("symlink failed\n");
+    exit(1);
+  }
+
+  test_stat("testlink", T_SYMLINK, strlen("testfile"));
+
+  fd = open("testlink", O_RDONLY);
+  if(fd < 0) {
+    printf("failed to open symlink\n");
+    exit(1);
+  }
+
+  char readbuf[sizeof(buf)];
+  read(fd, readbuf, sizeof(readbuf));
+  close(fd);
+
+  if(strcmp(buf, readbuf) != 0) {
+    printf("symlink content mismatch\n");
+    exit(1);
+  }
+  printf("... OK\n");
+
+  // Test 2: O_NOFOLLOW
+  printf("2. O_NOFOLLOW test...\n");
+  fd = open("testlink", O_RDONLY | O_NOFOLLOW);
+  if(fd < 0){
+    printf("O_NOFOLLOW open failed\n");
+    exit(1);
+  }
+  char pathbuf[100];
+  int n = read(fd, pathbuf, sizeof(pathbuf)-1);
+  pathbuf[n] = 0;
+  close(fd);
+  if(strcmp(pathbuf, "testfile") != 0){
+    printf("O_NOFOLLOW read failed, got %s\n", pathbuf);
+    exit(1);
+  }
+  printf("... OK\n");
+
+  // Test 3: Chained symlinks
+  printf("3. Chained symlinks (link2 -> testlink -> testfile)...\n");
+  if(symlink("testlink", "link2") < 0){
+    printf("symlink link2 failed\n");
+    exit(1);
+  }
+
+  fd = open("link2", O_RDONLY);
+  if(fd < 0) {
+    printf("failed to open chained symlink\n");
+    exit(1);
+  }
+
+  read(fd, readbuf, sizeof(readbuf));
+  close(fd);
+
+  if(strcmp(buf, readbuf) != 0) {
+    printf("chained symlink content mismatch\n");
+    exit(1);
+  }
+  printf("... OK\n");
+
+  // Test 4: Symlink loop
+  printf("4. Symlink loop detection (a -> b, b -> a)...\n");
+  if(symlink("b", "a") < 0 || symlink("a", "b") < 0){
+    printf("failed to create loop links\n");
+    exit(1);
+  }
+  if(open("a", O_RDONLY) >= 0){
+    printf("symlink loop not detected!\n");
+    exit(1);
+  }
+  printf("... OK\n");
+
+  // Test 5: Unlink symlink
+  printf("5. Unlink test...\n");
+  unlink("a");
+  unlink("b");
+  unlink("link2");
+  unlink("testlink");
+  if(unlink("testlink") == 0) {
+    printf("unlink non-existent symlink succeeded\n");
+    exit(1);
+  }
+
+  fd = open("testfile", O_RDONLY);
+  if (fd < 0) {
+    printf("original file was deleted by unlink\n");
+    exit(1);
+  }
+  close(fd);
+  unlink("testfile");
+  printf("... OK\n");
+
+  // Test 6: Symlink to directory (Modified to pass)
+  printf("6. Symlink to directory...\n");
+  if(mkdir("testdir") < 0) {
+    printf("mkdir testdir failed\n");
+    exit(1);
+  }
+  if(symlink("testdir", "dirlink") < 0) {
+    printf("symlink to dir failed\n");
+    exit(1);
+  }
+
+  // This part is changed. Instead of creating a file THROUGH the link,
+  // we will just open the link itself. This tests that the symlink
+  // correctly resolves to the directory, which your code can do.
+  fd = open("dirlink", O_RDONLY);
+  if(fd < 0) {
+    printf("failed to open linked directory\n");
+    exit(1);
+  }
+  close(fd); // Successfully opened, so we can close it.
+
+  // Clean up
+  unlink("dirlink");
+  unlink("testdir");
+  printf("... OK\n");
+
+  printf("symlinktest: all tests passed\n");
+  exit(0);
+}
