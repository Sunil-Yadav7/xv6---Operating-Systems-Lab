diff --git a/kernel/fs.c b/kernel/fs.c
index 9274678..6329d53 100644
--- a/kernel/fs.c
+++ b/kernel/fs.c
@@ -20,7 +20,7 @@
 #include "fs.h"
 #include "buf.h"
 #include "file.h"
-
+#define MAX_SYMLINK_DEPTH 10
 #define min(a, b) ((a) < (b) ? (a) : (b))
 // there should be one superblock per disk device, but we run with
 // only one device
@@ -440,6 +440,38 @@ bmap(struct inode *ip, uint bn)
     return addr;
   }
 
+  bn -= NINDIRECT;
+
+  // doubly-indirect
+  if(bn < NDOUBLE){
+    if((addr = ip->addrs[NDIRECT+1]) == 0)
+      ip->addrs[NDIRECT+1] = addr = balloc(ip->dev);
+
+    // L1 (pointers to indirect blocks)
+    bp = bread(ip->dev, addr);//l1 buffer cache fetched
+    uint *l1 = (uint*)bp->data;
+    uint i1 = bn / NINDIRECT;//block no
+    uint i2 = bn % NINDIRECT;//index within that
+
+    uint i1blk = l1[i1];
+    if(i1blk == 0){
+      l1[i1] = i1blk = balloc(ip->dev);
+      log_write(bp);
+    }
+    brelse(bp);
+
+    // L2 (indirect block with data addrs)
+    bp = bread(ip->dev, i1blk);//l2 buffer cache fetched
+    uint *l2 = (uint*)bp->data;
+    uint d = l2[i2];
+    if(d == 0){
+      l2[i2] = d = balloc(ip->dev);
+      log_write(bp);
+    }
+    brelse(bp);
+    return d;
+  }
+
   panic("bmap: out of range");
 }
 
@@ -471,6 +503,34 @@ itrunc(struct inode *ip)
     ip->addrs[NDIRECT] = 0;
   }
 
+  // free doubly-indirect blocks
+  if(ip->addrs[NDIRECT+1]){
+    // level-1 block holds NINDIRECT pointers to indirect blocks
+    bp = bread(ip->dev, ip->addrs[NDIRECT+1]);
+    uint *l1 = (uint*)bp->data;
+
+    for(i = 0; i < NINDIRECT; i++){
+      if(l1[i]){
+        // each referenced indirect block holds NINDIRECT data block addrs
+        struct buf *bp2 = bread(ip->dev, l1[i]);
+        uint *l2 = (uint*)bp2->data;
+
+        for(j = 0; j < NINDIRECT; j++){
+          if(l2[j])
+            bfree(ip->dev, l2[j]);
+        }
+
+        brelse(bp2);
+        bfree(ip->dev, l1[i]);   // free the indirect block itself
+        l1[i] = 0;
+      }
+    }
+
+    brelse(bp);
+    bfree(ip->dev, ip->addrs[NDIRECT+1]); // free the doubly-indirect block
+    ip->addrs[NDIRECT+1] = 0;
+  }
+
   ip->size = 0;
   iupdate(ip);
 }
