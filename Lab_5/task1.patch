diff --git a/user/bigfile.c b/user/bigfile.c
new file mode 100644
index 0000000..ce1d76d
--- /dev/null
+++ b/user/bigfile.c
@@ -0,0 +1,66 @@
+// user/bigfile.c
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "kernel/fs.h"
+#include "kernel/fcntl.h"  // <-- needed for O_CREATE, O_RDONLY, O_WRONLY, O_RDWR
+
+#define CHUNK 1024
+static uchar buf[CHUNK];
+
+int
+main(int argc, char *argv[])
+{
+  int fd, i;
+  const char *name = "big.bin";
+
+  // pattern
+  for(i = 0; i < CHUNK; i++) buf[i] = (uchar)(i & 0xff);
+
+  int blocks = 5 * 1024 * 1024 / CHUNK;  // ~5 MiB
+  printf("bigfile: writing %d blocks (%d bytes)\n", blocks, blocks*CHUNK);
+
+  // create & write
+  fd = open(name, O_CREATE | O_WRONLY);
+  if(fd < 0){
+    printf("bigfile: open for create failed\n");
+    exit(1);
+  }
+
+  for(i = 0; i < blocks; i++){
+    buf[0] = (uchar)(i & 0xff);
+    if(write(fd, buf, CHUNK) != CHUNK){
+      printf("bigfile: write failed at block %d\n", i);
+      close(fd);
+      exit(1);
+    }
+    if((i % 1000) == 0) printf("  wrote block %d\n", i);
+  }
+  close(fd);
+
+  // verify
+  fd = open(name, O_RDONLY);
+  if(fd < 0){
+    printf("bigfile: reopen failed\n");
+    exit(1);
+  }
+
+  for(i = 0; i < blocks; i++){
+    if(read(fd, buf, CHUNK) != CHUNK){
+      printf("bigfile: read failed at block %d\n", i);
+      close(fd);
+      exit(1);
+    }
+    if(buf[0] != (uchar)(i & 0xff) || buf[1] != 1 || buf[2] != 2){
+      printf("bigfile: data mismatch at block %d (got %u,%u,%u)\n",
+             i, buf[0], buf[1], buf[2]);
+      close(fd);
+      exit(1);
+    }
+    if((i % 1000) == 0) printf("  verified block %d\n", i);
+  }
+  close(fd);
+
+  printf("bigfile: OK\n");
+  exit(0);
+}
\ No newline at end of file
