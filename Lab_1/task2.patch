diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index 419e727..da5acad 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -107,3 +107,30 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+extern struct proc proc[];
+
+uint64
+sys_top(void)
+{
+  struct proc *p;
+
+  printf("PID\tState\t\tName\t\tTicks\n");
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->state != UNUSED) {
+      printf("%d \t%s \t%s\t\t%d\n", p->pid,
+        p->state == RUNNING ? "RUNNING" :
+        p->state == SLEEPING ? "SLEEPING" :
+        p->state == ZOMBIE ? "ZOMBIE" :
+        p->state == RUNNABLE ? "RUNNABLE" :
+        "OTHER",
+        p->name,
+        p->rtime); // <--- Here
+    }
+    release(&p->lock);
+  }
+
+  return 0;
+}
