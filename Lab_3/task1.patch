+
+//changes for task 1
+
+uint64
+sys_shm_create(void)
+{
+  int key; argint(0, &key);
+  return shm_create_k(key);
+}
+
+uint64
+sys_shm_get(void)
+{
+  int key; argint(0, &key);
+  return shm_get_k(key);       // returns VA (0 on error)
+}
+
+uint64
+sys_shm_close(void)
+{
+  int key; argint(0, &key);
+  return shm_close_k(key);
