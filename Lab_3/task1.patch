+sys_mbox_create(void)
+{
+  int key; argint(0, &key);
+  return mbox_create_k(key);
+}
+
+uint64
+sys_mbox_send(void)
+{
+  int id, msg;
+  argint(0, &id);
+  argint(1, &msg);
+  return mbox_send_k(id, msg);
+}
+
+uint64
+sys_mbox_recv(void)
+{
+  int id; uint64 uptr;
+  argint(0, &id);
+  argaddr(1, &uptr);
+  int v;
+  int r = mbox_recv_k(id, &v);   // may block
+  if(r < 0) return -1;
+  if(copyout(myproc()->pagetable, uptr, (char*)&v, sizeof(v)) < 0) return -1;
+  return 0;
+}
